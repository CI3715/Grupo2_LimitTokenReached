# Copia este archivo como .env en la raíz y genera un JWT_SECRET privado.
SERVER_HOST_IP=http://localhost:8000
DATABASE_PATH=servidor/data/usuarios_auth.db
# Optional PostgreSQL connection URI; when set, it overrides DATABASE_PATH.
DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=cuentas-claras
JWT_TTL_MINUTES=60
